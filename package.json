{
  "name": "gpt-live-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:deployment": "node --test scripts/*.test.mjs",
    "types": "wrangler types --include-env false",
    "dev": "wrangler dev --port 8787",
    "dev:swa": "swa start",
    "setup:swa": "node ./scripts/setup-swa.mjs",
    "deploy": "npm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --env \"\" --dry-run",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy:preview:dry-run": "wrangler deploy --env preview --dry-run",
    "deploy:production": "node ./scripts/deploy-with-domain.mjs --production",
    "deploy:domain": "node ./scripts/deploy-with-domain.mjs --production",
    "deploy:swa": "node ./scripts/deploy-swa.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.10",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  }
}
